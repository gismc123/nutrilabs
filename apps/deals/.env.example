# KrogerDeals settings. Copy to .env (gitignored) and fill in. Never commit .env.

# Compose files to load. Drop the second one if NutriLabs is not running here.
COMPOSE_FILE=docker-compose.yml:docker-compose.nutrilabs.yml

# Host port for the web app (the Cloudflare tunnel points here).
DEALS_PORT=1043
TZ=America/Chicago

# Database password for the deals-db container. openssl rand -hex 24
DEALS_DB_PASSWORD=
# Signs login sessions, at least 32 characters. openssl rand -hex 48
DEALS_JWT_SECRET=
# Shared secret between the worker and the server's internal port. openssl rand -hex 32
DEALS_WORKER_TOKEN=

# Free Kroger developer API (developer.kroger.com), client credentials app.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Product API calls allowed per day (free tier limit is 10,000).
KROGER_DAILY_PRODUCT_BUDGET=6000
# Zip prefilled in Settings.
DEALS_DEFAULT_ZIP=
# Nightly price sync (cron, in TZ).
PRICE_SYNC_CRON=30 4 * * *

# Optional NutriLabs link: its internal API address and its PRICER_TOKEN.
NUTRILABS_URL=http://nutrilabs-api:3001
NUTRILABS_PRICER_TOKEN=

# Worker: where the Kroger browser profile lives. Must be outside the repo.
DEALS_STATE_DIR=/home/YOUR_USER/.local/share/krogerdeals
# true: when the Kroger login has expired, still sync the public coupon list.
DEALS_ALLOW_SIGNED_OUT=true
KROGER_DOMAIN=kroger.com
