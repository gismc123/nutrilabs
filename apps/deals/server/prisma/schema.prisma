// KrogerDeals data model. Shaped by COUPON-SCHEMA.md. Raw Kroger payloads are kept
// in JSON columns so the parser can be fixed later without fetching again.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String
  isAdmin      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  listItems    ListItem[]

  @@map("users")
}

// Single row (id = 1): the store and integrations this instance uses.
model AppConfig {
  id               Int      @id @default(1)
  zip              String?
  locationId       String?
  nutrilabsUserId  Int?
  updatedAt        DateTime @updatedAt

  @@map("app_config")
}

model Store {
  locationId String   @id
  name       String
  address    String?
  zip        String?
  lat        Float?
  lng        Float?
  updatedAt  DateTime @updatedAt
  prices     Price[]
  current    StorePrice[]

  @@map("stores")
}

model Product {
  upc         String          @id
  productId   String?
  name        String
  brand       String?
  size        String?
  soldBy      String?
  category    String?
  categories  String[]
  imageUrl    String?
  aisle       String?
  raw         Json?
  updatedAt   DateTime        @updatedAt
  prices      Price[]
  current     StorePrice[]
  coupons     CouponProduct[]

  @@index([brand])
  @@map("products")
}

// Price history: one row per product, store, and capture.
model Price {
  id          Int      @id @default(autoincrement())
  upc         String
  locationId  String
  regular     Float?
  promo       Float?
  promoEnds   DateTime?
  capturedAt  DateTime @default(now())
  raw         Json?
  product     Product  @relation(fields: [upc], references: [upc], onDelete: Cascade)
  store       Store    @relation(fields: [locationId], references: [locationId], onDelete: Cascade)

  @@index([upc, locationId, capturedAt])
  @@map("prices")
}

// Latest known price per product and store, kept beside the history for fast reads.
model StorePrice {
  upc         String
  locationId  String
  regular     Float?
  promo       Float?
  promoEnds   DateTime?
  capturedAt  DateTime
  product     Product  @relation(fields: [upc], references: [upc], onDelete: Cascade)
  store       Store    @relation(fields: [locationId], references: [locationId], onDelete: Cascade)

  @@id([upc, locationId])
  @@index([locationId, promo])
  @@map("store_prices")
}

model Coupon {
  id                 String          @id // Kroger coupon id
  offerId            String?
  couponNumber       String?
  title              String
  description        String
  terms              String?
  brand              String?
  categories         String[]
  discountType       String // AMOUNT_OFF | PERCENT_OFF | FIXED_PRICE | BOGO | FREE_WITH_PURCHASE | POINTS | SERVICE | UNKNOWN
  amountOff          Float?
  percentOff         Float?
  fixedPrice         Float?
  sizeRefPrice       Float? // fixed-price deals: regular price of the smallest matched size
  perLb              Boolean         @default(false)
  minQuantity        Int             @default(1)
  minSpend           Float?
  usageLimit         Int? // null = not limited by the coupon
  pickupDeliveryOnly Boolean         @default(false)
  weeklyDigitalDeal  Boolean         @default(false)
  specialSavings     String[]
  clipped            Boolean         @default(false)
  imageUrl           String?
  startDate          DateTime?
  expiryDate         DateTime?
  source             String          @default("kroger-digital")
  status             String          @default("active") // active | expired | removed
  matchStatus        String          @default("pending") // pending | matched | unmatched | not_grocery
  searchedAt         DateTime? // last targeted product search for linking
  firstSeenAt        DateTime        @default(now())
  lastSeenAt         DateTime        @default(now())
  capturedAt         DateTime        @default(now())
  raw                Json
  products           CouponProduct[]

  @@index([status, expiryDate])
  @@index([brand])
  @@map("coupons")
}

model CouponProduct {
  couponId   String
  upc        String
  confidence String // high | medium
  score      Float
  reason     String
  coupon     Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [upc], references: [upc], onDelete: Cascade)

  @@id([couponId, upc])
  @@index([upc])
  @@map("coupon_products")
}

model SyncRun {
  id         Int       @id @default(autoincrement())
  kind       String // coupons | prices
  startedAt  DateTime
  finishedAt DateTime?
  status     String // running | ok | partial | session_expired | failed
  signedIn   Boolean?
  counts     Json?
  error      String?
  note       String?

  @@index([kind, startedAt])
  @@map("sync_runs")
}

// Search terms priced on every nightly run.
model WatchTerm {
  term         String    @id
  source       String // staple | wanted | nutrilabs | lookup
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  @@map("watch_terms")
}

// Cached product search results (term + store -> upcs) to save API calls.
model ProductSearch {
  key       String   @id // "<locationId>|<query>"
  query     String
  upcs      String[]
  at        DateTime

  @@map("product_searches")
}

// Kroger API calls per UTC day, to stay under the free-tier limits.
model ApiUsage {
  day       String @id // YYYY-MM-DD
  products  Int    @default(0)
  locations Int    @default(0)
  tokens    Int    @default(0)

  @@map("api_usage")
}

model ListItem {
  id         Int      @id @default(autoincrement())
  userId     Int
  name       String
  upc        String?
  couponId   String?
  quantity   Int      @default(1)
  unitPrice  Float?
  regular    Float?
  needsClip  Boolean  @default(false)
  checked    Boolean  @default(false)
  note       String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("list_items")
}
