generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum RecipeSource {
  USER
  AI
  SPOONACULAR
  THEMEALDB
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum HouseholdMode {
  SOLO
  DAD_MODE
}

enum GroceryCategory {
  PRODUCE
  PROTEIN
  DAIRY
  GRAINS
  CANNED
  FROZEN
  MISC
}

enum WeekStartDay {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

enum PantryItemSource {
  SCANNED
  MANUAL
}

model User {
  id                 Int                   @id @default(autoincrement())
  email              String                @unique
  passwordHash       String
  displayName        String?
  isActive           Boolean               @default(true)
  deactivatedAt      DateTime?
  scheduledPurgeAt   DateTime?
  passwordChangedAt  DateTime?
  // Instance admin: edits the shared recipe library and instance-wide settings
  // (Ollama host, SMTP). The account created by first-run setup.
  isAdmin            Boolean               @default(false)
  createdAt          DateTime              @default(now())
  recipes            Recipe[]
  profiles           Profile[]
  mealPlans          MealPlan[]
  eatingOutLogs      EatingOutLog[]
  settings           AppSettings?
  custodyTemplate    CustodyTemplate[]
  pantryStaples      PantryStaple[]
  pantryInventory    PantryInventoryItem[]
  passwordResetTokens PasswordResetToken[]
  dealListItems      DealListItem[]
}

model Profile {
  id            Int      @id @default(autoincrement())
  userId        Int
  name          String
  age           Int?
  avatarColor   String
  isPlanner     Boolean  @default(false)
  dietaryNotes  String?
  foodDislikes  String?
  calorieTarget Int?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}

model Recipe {
  id              Int           @id @default(autoincrement())
  name            String
  description     String?
  mealType        MealType
  servings        Int           @default(1)
  prepTimeMinutes Int?
  costPerServing  Decimal?      @db.Decimal(8, 2)
  calories        Int?
  proteinG        Int?
  carbsG          Int?
  fatG            Int?
  isKidFriendly   Boolean       @default(true)
  tags            String[]
  source          RecipeSource
  instructions    String?
  imageUrl        String?
  spoonacularId   Int?
  mealDbId        Int?
  // Owner. Null = shared library recipe: readable by everyone, editable by admins.
  userId          Int?
  user            User?         @relation(fields: [userId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ingredients     Ingredient[]
  plannedMeals    PlannedMeal[]
  plannedSides    PlannedMealSide[]

  @@unique([userId, spoonacularId])
  @@unique([userId, mealDbId])
  @@index([userId])
}

model Ingredient {
  id         Int      @id @default(autoincrement())
  recipeId   Int
  name       String
  quantity   Decimal? @db.Decimal(10, 3)
  unit       String?
  isOptional Boolean  @default(false)
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model MealPlan {
  id            Int           @id @default(autoincrement())
  userId        Int
  weekStartDate DateTime      @db.Date
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id])
  plannedMeals  PlannedMeal[]
  dayConfigs    DayConfig[]
  groceryList   GroceryList?

  @@unique([userId, weekStartDate])
}

model DayConfig {
  id               Int           @id @default(autoincrement())
  mealPlanId       Int
  dayOfWeek        DayOfWeek
  householdMode    HouseholdMode
  activeProfileIds Int[]
  mealPlan         MealPlan      @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@unique([mealPlanId, dayOfWeek])
}

model PlannedMeal {
  id         Int       @id @default(autoincrement())
  mealPlanId Int
  dayOfWeek  DayOfWeek
  mealType   MealType
  recipeId   Int?
  eaten      Boolean   @default(false)
  eatenAt    DateTime?
  mealPlan   MealPlan  @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe     Recipe?   @relation(fields: [recipeId], references: [id])
  sides      PlannedMealSide[]

  @@unique([mealPlanId, dayOfWeek, mealType])
}

// A side dish served with a planned meal. Either a library recipe (its
// ingredients go on the grocery list) or a quick item with no recipe, such as
// "bagged salad", which goes on the list as one item.
model PlannedMealSide {
  id            Int         @id @default(autoincrement())
  plannedMealId Int
  recipeId      Int?
  name          String?
  position      Int         @default(0)
  createdAt     DateTime    @default(now())
  plannedMeal   PlannedMeal @relation(fields: [plannedMealId], references: [id], onDelete: Cascade)
  recipe        Recipe?     @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([plannedMealId])
  @@index([recipeId])
}

model GroceryList {
  id          Int           @id @default(autoincrement())
  mealPlanId  Int           @unique
  generatedAt DateTime      @default(now())
  sourceHash  String?
  loggedSpend Int?
  loggedStore String?
  loggedAt    DateTime?
  mealPlan    MealPlan      @relation(fields: [mealPlanId], references: [id])
  items       GroceryItem[]
}

model GroceryItem {
  id                    Int             @id @default(autoincrement())
  groceryListId         Int
  name                  String
  normalizedName        String?
  quantity              Decimal?        @db.Decimal(10, 3)
  unit                  String?
  category              GroceryCategory
  checked               Boolean         @default(false)
  estimatedPriceWalmart Int?
  estimatedPriceKroger  Int?
  estimatedPriceAldi    Int?
  isPantryStaple        Boolean         @default(false)
  groceryList           GroceryList     @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
}

model EatingOutLog {
  id            Int           @id @default(autoincrement())
  userId        Int
  date          DateTime      @db.Date
  mealType      MealType
  placeName     String?
  amount        Int
  householdMode HouseholdMode
  notes         String?
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id])
}

model AppSettings {
  id                 Int          @id @default(autoincrement())
  userId             Int          @unique
  weekStartDay       WeekStartDay @default(SUN)
  weeklyBudget       Int          @default(12000)
  eatingOutReference Int          @default(1200)
  ollamaHost         String       @default("http://192.168.1.190:11434")
  ollamaModel        String       @default("llama3")
  krogerZip          String?
  krogerRadiusMiles  Int          @default(25)
  krogerLocationId   String?
  krogerStoreName    String?
  meijerZip          String?
  meijerRadiusMiles  Int          @default(25)
  meijerStoreId      String?
  meijerStoreName    String?
  spoonacularApiKey  String?
  usdaApiKey         String?
  dateFormat         String       @default("MM/DD/YYYY")
  currency           String       @default("USD")
  smtpHost           String?
  smtpPort           Int?         @default(587)
  smtpUser           String?
  smtpPassword       String?
  smtpFromAddress    String?
  smtpFromName       String       @default("NutriLabs")
  appBaseUrl         String?
  user               User         @relation(fields: [userId], references: [id])
}

model CustodyTemplate {
  id                Int           @id @default(autoincrement())
  userId            Int
  dayOfWeek         DayOfWeek
  householdMode     HouseholdMode
  isAlternatingWeek Boolean       @default(false)
  user              User          @relation(fields: [userId], references: [id])

  @@unique([userId, dayOfWeek, isAlternatingWeek])
}

model PantryStaple {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, name])
}

model RecipeImportCache {
  id            Int      @id @default(autoincrement())
  spoonacularId Int      @unique
  rawJson       String
  fetchedAt     DateTime @default(now())
}

model PantryInventoryItem {
  id               Int              @id @default(autoincrement())
  userId           Int
  name             String
  brand            String?
  barcode          String?
  servingSize      String?
  servingSizeG     Decimal?         @db.Decimal(8, 2)
  calories         Int?
  proteinG         Decimal?         @db.Decimal(6, 2)
  carbsG           Decimal?         @db.Decimal(6, 2)
  fatG             Decimal?         @db.Decimal(6, 2)
  ingredients      String?
  imageUrl         String?
  quantity         Decimal          @default(1) @db.Decimal(8, 2)
  unit             String           @default("serving")
  openFoodFactsId  String?
  source           PantryItemSource
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  // SHA-256 of the emailed token; the token itself is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

// USDA food per ingredient name (matchKey). userId 0 rows cache automatic picks for
// everyone; a user's corrections from the macro calculator live in their own rows.
model FoodMatch {
  key            String
  // 0 = the shared automatic match; a user id = that user's own correction.
  userId         Int      @default(0)
  fdcId          Int?
  description    String?
  dataType       String?
  calories       Float?
  proteinG       Float?
  carbsG         Float?
  fatG           Float?
  portions       Json     @default("[]")
  unitGrams      Json     @default("{}")
  skip           Boolean  @default(false)
  isUserChoice   Boolean  @default(false)
  matcherVersion Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@id([key, userId])
}

// ---- KrogerDeals (apps/api/src/deals) ----------------------------------------
// Kroger sale prices and digital coupons. Shared catalog and coupons; prices per
// store; the deal list per user. Raw Kroger payloads are kept in JSON columns so
// the parser can be fixed later without fetching again.

model DealStore {
  locationId String   @id
  name       String
  address    String?
  zip        String?
  lat        Float?
  lng        Float?
  updatedAt  DateTime @updatedAt
  prices     DealPrice[]
  current    DealStorePrice[]

  @@map("deal_stores")
}

model DealProduct {
  upc         String          @id
  productId   String?
  name        String
  brand       String?
  size        String?
  soldBy      String?
  category    String?
  categories  String[]
  imageUrl    String?
  aisle       String?
  raw         Json?
  updatedAt   DateTime        @updatedAt
  prices      DealPrice[]
  current     DealStorePrice[]
  coupons     DealCouponProduct[]

  @@index([brand])
  @@map("deal_products")
}

// Price history: one row per product, store, and capture.
model DealPrice {
  id          Int      @id @default(autoincrement())
  upc         String
  locationId  String
  regular     Float?
  promo       Float?
  promoEnds   DateTime?
  capturedAt  DateTime @default(now())
  raw         Json?
  product     DealProduct  @relation(fields: [upc], references: [upc], onDelete: Cascade)
  store       DealStore    @relation(fields: [locationId], references: [locationId], onDelete: Cascade)

  @@index([upc, locationId, capturedAt])
  @@map("deal_prices")
}

// Latest known price per product and store, kept beside the history for fast reads.
model DealStorePrice {
  upc         String
  locationId  String
  regular     Float?
  promo       Float?
  promoEnds   DateTime?
  capturedAt  DateTime
  product     DealProduct  @relation(fields: [upc], references: [upc], onDelete: Cascade)
  store       DealStore    @relation(fields: [locationId], references: [locationId], onDelete: Cascade)

  @@id([upc, locationId])
  @@index([locationId, promo])
  @@map("deal_store_prices")
}

model DealCoupon {
  id                 String          @id // Kroger coupon id
  offerId            String?
  couponNumber       String?
  title              String
  description        String
  terms              String?
  brand              String?
  categories         String[]
  discountType       String // AMOUNT_OFF | PERCENT_OFF | FIXED_PRICE | BOGO | FREE_WITH_PURCHASE | POINTS | SERVICE | UNKNOWN
  amountOff          Float?
  percentOff         Float?
  fixedPrice         Float?
  sizeRefPrice       Float? // fixed-price deals: regular price of the smallest matched size
  perLb              Boolean         @default(false)
  minQuantity        Int             @default(1)
  minSpend           Float?
  usageLimit         Int? // null = not limited by the coupon
  pickupDeliveryOnly Boolean         @default(false)
  weeklyDigitalDeal  Boolean         @default(false)
  specialSavings     String[]
  clipped            Boolean         @default(false)
  imageUrl           String?
  startDate          DateTime?
  expiryDate         DateTime?
  source             String          @default("kroger-digital")
  status             String          @default("active") // active | expired | removed
  matchStatus        String          @default("pending") // pending | matched | unmatched | not_grocery
  searchedAt         DateTime? // last targeted product search for linking
  firstSeenAt        DateTime        @default(now())
  lastSeenAt         DateTime        @default(now())
  capturedAt         DateTime        @default(now())
  raw                Json
  products           DealCouponProduct[]

  @@index([status, expiryDate])
  @@index([brand])
  @@map("deal_coupons")
}

model DealCouponProduct {
  couponId   String
  upc        String
  confidence String // high | medium
  score      Float
  reason     String
  coupon     DealCoupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product    DealProduct @relation(fields: [upc], references: [upc], onDelete: Cascade)

  @@id([couponId, upc])
  @@index([upc])
  @@map("deal_coupon_products")
}

model DealSyncRun {
  id         Int       @id @default(autoincrement())
  kind       String // coupons | prices
  startedAt  DateTime
  finishedAt DateTime?
  status     String // running | ok | partial | session_expired | failed
  signedIn   Boolean?
  counts     Json?
  error      String?
  note       String?

  @@index([kind, startedAt])
  @@map("deal_sync_runs")
}

// One coupon refresh: nightly or scheduled from the Store tab. The host timer
// claims due ones; at most one starts per 4 hours.
model DealRefreshRequest {
  id          Int       @id @default(autoincrement())
  kind        String // manual | nightly
  runAt       DateTime
  status      String // scheduled | running | done | failed | skipped | canceled
  requestedBy Int?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  exitCode    Int?
  message     String?

  @@index([status, runAt])
  @@index([kind, runAt])
  @@map("deal_refresh_requests")
}

// Search terms priced on every nightly run.
model DealWatchTerm {
  term         String    @id
  source       String // staple | wanted | nutrilabs | lookup
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  @@map("deal_watch_terms")
}

// Cached product search results (term + store -> upcs) to save API calls.
model DealProductSearch {
  key       String   @id // "<locationId>|<query>"
  query     String
  upcs      String[]
  at        DateTime

  @@map("deal_product_searches")
}

// Kroger API calls per UTC day, to stay under the free-tier limits.
model DealApiUsage {
  day       String @id // YYYY-MM-DD
  products  Int    @default(0)
  locations Int    @default(0)
  tokens    Int    @default(0)

  @@map("deal_api_usage")
}

model DealListItem {
  id         Int      @id @default(autoincrement())
  userId     Int
  name       String
  upc        String?
  couponId   String?
  quantity   Int      @default(1)
  unitPrice  Float?
  regular    Float?
  needsClip  Boolean  @default(false)
  checked    Boolean  @default(false)
  note       String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("deal_list_items")
}
