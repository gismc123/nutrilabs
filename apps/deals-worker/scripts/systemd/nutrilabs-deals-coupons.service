# Installed by scripts/install-timer.sh into ~/.config/systemd/user/
[Unit]
Description=NutriLabs Deals nightly coupon sync (headed browser on the desktop display)

[Service]
Type=oneshot
WorkingDirectory=@DEALS_DIR@
ExecStart=@DEALS_DIR@/scripts/run-worker.sh sync
StandardOutput=append:@LOG_DIR@/worker.log
StandardError=append:@LOG_DIR@/worker.log
TimeoutStartSec=20min
