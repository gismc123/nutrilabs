[Unit]
Description=Check every minute whether a NutriLabs Deals coupon refresh is due

[Timer]
# NutriLabs decides what runs: the nightly refresh (DEALS_COUPON_SYNC_TIME, 3:45 by
# default, before the 4:30 price sync) or one scheduled from Deals > Store. It
# allows one refresh every 4 hours. Checks while a run is going are skipped.
OnCalendar=*-*-* *:*:00
AccuracySec=5s
Persistent=false

[Install]
WantedBy=timers.target
